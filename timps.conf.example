# timps configuration (plain key = value, replaces libconfig)
# Copy to /etc/timps.conf and adjust for your camera.

# ---- general ----
general.loglevel            = 2      # 0=err 1=warn 2=info 3=debug
# Raise single modules to debug WITHOUT raising loglevel. Names, not a bitmask:
# a mask is a magic number that quietly means something else once a module is
# added. The device's syslog ring is 64 KB and recycles in minutes under load,
# so a global debug level loses the very lines it was raised for.
# Tags: MAIN CONFIG CTRL DAYNIGHT HAL_ING HTTP HUB MOTION OSD REC RTSP SRT TL
#       HAL_SIM TLS AAC bc spk TRACE
# general.debug_modules     = HAL_ING,DAYNIGHT
general.syslog              = 1      # 1 = also log to syslog so messages show up
                                     #     in `logread` (the init script backgrounds
                                     #     timpsd, so its stderr is discarded);
                                     #     0 = stderr only (foreground / host sim)
general.imp_polling_timeout = 500    # ms, encoder poll timeout
general.osd_pool_size       = 1024   # KB, IMP OSD pool (this is the default)

# ---- sensor ----
# OPTIONAL: leave any of these out (or empty/0) and timps auto-detects it from
# the Ingenic kernel sensor registry /proc/jz/sensor/sensor0/ (name/i2c_addr/
# width/height/max_fps), like raptor/prudynt - so one config works across
# cameras. A value set here always wins; a safe fallback applies if neither the
# config nor the registry has it (host sim / T40/T41 have no registry).
sensor.model    = gc2053
sensor.i2c_addr = 0x37
sensor.fps      = 25
sensor.width    = 1920
sensor.height   = 1080

# ---- image / ISP tuning (all 0..255 unless noted; 128 = neutral) ----
image.brightness             = 128
image.contrast               = 128
image.saturation             = 128
image.sharpness              = 128
image.hue                    = 128
image.hflip                  = 0
image.vflip                  = 0
image.anti_flicker           = 2     # 0 off, 1 = 50Hz, 2 = 60Hz
image.running_mode           = 0     # 0 day, 1 night
image.ae_compensation        = 128
image.max_again              = 160
image.max_dgain              = 80
image.sinter_strength        = 128   # spatial NR
image.temper_strength        = 128   # temporal NR
image.dpc_strength           = 128
image.defog_strength         = 128
image.drc_strength           = 128
image.highlight_depress      = 0
image.backlight_compensation = 0
image.core_wb_mode           = 0     # 0 auto
image.wb_rgain               = 0
image.wb_bgain               = 0

# ---- SECURITY --------------------------------------------------------------
# Authentication is OFF while user/pass are empty (the shipped default). Set
# credentials to lock the device: RTSP then requires Digest auth, HTTP requires
# Basic auth. Strongly recommended.
#
# WARNING - what "empty credentials" actually exposes (by design):
#   While rtsp.user AND http.user are empty, the MEDIA endpoints are reachable
#   by ANYONE who can reach the port, with NO authentication:
#     - the RTSP video+audio stream (rtsp://<ip>:554/chN)
#     - HTTP snapshot   /snapshot.jpg
#     - HTTP MJPEG      /stream.mjpeg  (and /mjpeg)
#     - HTTP fMP4 live  /stream.mp4
#   i.e. anyone on the network can watch and listen to the camera. Only the
#   CONTROL surface is protected regardless of credentials: /control and
#   /events answer 403 to any NON-loopback client while no credentials are set,
#   so config/state can only be read or changed from the device itself (or via
#   the per-boot/persistent token, or once real credentials are configured).
#   To require auth for the media too, set rtsp.user/pass and/or http.user/pass
#   below.
# NOTE: HTTP Basic sends credentials base64-encoded; use it on a trusted LAN or
# behind a TLS reverse proxy.

# ---- RTSP server (video + audio, no live555) ----
rtsp.enabled = 1
rtsp.port    = 554
# rtsp.mtu   = 1200         # max RTP packet size (548..1472). Default 1200
#                           # survives WireGuard/OpenVPN/PPPoE paths without
#                           # IP fragmentation; 1400 squeezes ~1% more payload
#                           # efficiency on plain-Ethernet LANs
rtsp.user    =            # set to enable RTSP Digest auth. EMPTY = the RTSP
                          #   video/audio stream is open to anyone on the network
rtsp.pass    =

# ---- HTTP preview (fMP4 + JPEG/MJPEG) ----
http.enabled     = 1
http.port        = 8880
http.preview_chn = 1
# Per-client adaptive frame-dropping for the fMP4 (/stream.mp4) preview path.
# When one preview client's link can't keep up, that client alone freezes on
# its last frame and resumes cleanly at the next keyframe (no decode corruption)
# instead of forwarding a headless GOP. Strictly per-client: never touches the
# encoder or any other subscriber (Frigate, recording, other viewers).
# 1 = on (default; hardware-verified), 0 = off (forward every frame - the
# pre-feature behavior). Leave at the default unless you have a specific reason
# to forward every frame regardless of a slow client's link.
http.adaptive_drop = 1
http.user        =        # set to enable HTTP Basic auth (empty = reuse rtsp.user/pass).
                          #   While BOTH this and rtsp.user are empty, the HTTP media
                          #   endpoints (/snapshot.jpg, /stream.mjpeg, /stream.mp4) are
                          #   open to anyone on the network. /control and /events stay
                          #   loopback-only regardless. See the SECURITY note above.
http.pass        =
#
# Token auth (USE_CONTROL builds). /control, /events and the HTTP media
# endpoints (/stream.mp4, /stream.mjpeg, /snapshot.jpg, incl. ?chn=N) accept,
# besides localhost and HTTP Basic, a token sent as
#     X-Timps-Token: <token>          header (preferred), or
#     ?token=<token>                  query string - the only form <img>/
#                                     <video src>/EventSource can use
#                                     (CAUTION: query strings can end up in
#                                     proxy/access logs; fine on a LAN)
# Two tokens are valid:
#   1. a random PER-BOOT token, regenerated on every start and written to
#      http.token_file (mode 0640) so a local privileged helper (the thingino
#      WebUI) can read it and let the browser talk to :8880 directly;
#   2. the optional PERSISTENT secret http.token below - a stable credential
#      for remote automation. It is NEVER written to http.token_file.
# The token unlocks /control + /events + HTTP media VIEWING - never RTSP,
# and nothing else on the port. Like Basic auth, tokens travel in cleartext:
# put TLS in front before exposing the port to the internet.
http.token       =
http.token_file  = /run/timps.token

# ---- optional TLS: HTTPS + RTSPS (USE_TLS builds, mbedTLS) ----
# Only present when timps is built with mbedTLS (BR2_PACKAGE_MBEDTLS). Without
# it these keys are parsed but ignored and timps stays plain HTTP/RTSP - the
# only other symptom is a "RTSPS requested but built without USE_TLS" line in
# the log. To check a running camera without SSH, read the top-level "tls"
# object of GET /control: {"available":0} means THIS binary has no TLS and
# every key below is inert, however it is set here.  (Same idea as srt.* and
# the caps.*.available flags: the firmware package and a standalone build.sh
# binary are not compiled with the same feature set, and the version string
# cannot tell them apart.)
# S95timps makes sure a usable cert/key pair exists before timpsd starts, so a
# cert-less first boot still comes up with a working TLS listener.
# On an image that ships the thingino WebUI, S95timps points
# the two paths below at the WebUI's OWN certificate (/etc/ssl/certs/uhttpd.crt)
# instead of generating a second one, so :443 and :8880 present the IDENTICAL
# certificate and trusting the WebUI once also covers the preview's cross-origin
# fetches. Without that, a browser tracks self-signed trust per origin
# (host+PORT) and Safari offers no click-through for fetch()/XHR at all - the
# preview just fails with "Load failed". On an image without the WebUI the pair
# below is generated as timps' own self-signed cert, and you do still have to
# visit https://<ip>:8880/ once to trust it. https stays opt-in either way.
# Session resumption (RFC 5077 tickets) is always on and needs no key here: a
# client that reconnects skips the full handshake, trading some forward secrecy
# for it - a resumed session is decryptable by whoever holds the ticket key,
# which timps rotates every 12h. Full handshakes stay forward-secret.
# http.https    = 1                       # serve the HTTP port over TLS
http.tls_cert   = /etc/ssl/certs/timps.crt
http.tls_key    = /etc/ssl/private/timps.key
# rtsp.tls      = 1                       # additionally run an RTSPS listener
# rtsp.tls_port = 322                     # RTSPS port

# ---- SRT output (USE_SRT builds, libsrt) ----
# MPEG-TS over SRT. Default mode is listener: ffplay srt://<ip>:9000
# mode=caller dials out instead (camera behind NAT / unreliable uplink) and
# reconnects on its own with a capped backoff (1s doubling to 30s); srt.port
# is then the REMOTE port. While a receiver is connected, a machine-readable
# "stats:" line (retransmits/loss/RTT/bandwidth) is logged every 10 s and the
# latest sample is visible under "srt" in GET /control.
srt.enabled    = 1
srt.port       = 9000
# srt.mode       = listener               # listener (default) | caller
# srt.host       =                        # caller mode: receiver host/IP
# srt.channel    = 0
# srt.latency_ms = 120
# srt.streamid   =                        # listener: required STREAMID;
#                                         # caller: STREAMID to present
# srt.passphrase =                        # optional AES passphrase

# ---- /events push stream (SSE, USE_CONTROL builds) ----
# GET /events on the HTTP port is a long-lived text/event-stream that PUSHES
# JSON state as it changes instead of being polled: "motion" (grid cells),
# "daynight" (mode/brightness/gain) and a periodic "stats" event (clients,
# per-stream fps, uptime). ?stream=motion,daynight,stats filters the types.
# Access rules are the /control ones (localhost / token / Basic); browsers
# use ?token= because EventSource cannot send headers (query strings can end
# up in logs - accepted on the LAN, the token never unlocks RTSP).
# Startup settings, deliberately not settable via /control.
events.enabled     = 1
events.stats_ms    = 2000    # "stats" event period in ms (0 = no stats events)
events.max_clients = 8       # concurrent /events connections (above -> 503)
# ^ reported to clients as caps.events_max_clients in GET /control, next to the
# compile-time RTSP/HTTP ceilings (caps.rtsp_max_clients/caps.http_max_clients),
# so a client can see what it may open instead of finding out by being refused.

# ---- JPEG / MJPEG stream (the old streamer's "stream2") ----
# HTTP endpoints:  /snapshot.jpg (single frame)   /stream.mjpeg (motion JPEG)
jpeg.enabled       = 1
jpeg.width         = 640
jpeg.height        = 360
jpeg.quality       = 75          # 1..100
jpeg.fps           = 5           # max MJPEG frame rate
jpeg.imp_chn       = 2           # JPEG encoder channel
# jpeg.snapshot_path = /tmp/snapshot.jpg   # also write a periodic file snapshot
#
# Additional JPEG resolutions: an extra JPEG encoder can piggyback on any
# video stream. It shares that stream's framesource (no extra rmem, unlike a
# second dedicated jpeg channel) and delivers JPEGs at the stream resolution.
# Fetch with:  /snapshot.jpg?chn=0   /stream.mjpeg?chn=1   (no ?chn= = jpeg.*)
# On-demand like everything else: no CPU/encoder cost until a client fetches.
# The thingino WebUI previews fetch /stream.mjpeg?chn=N + /snapshot.jpg?chn=N
# directly from this port (with ?token=, see above - no proxy CGIs), so keep
# these enabled when timps runs under thingino.
video0.jpeg         = true      # JPEG at video0 resolution (e.g. 1920x1080)
video0.jpeg_quality = 75
video0.jpeg_fps     = 5
video0.jpeg_chn     = 3         # unique IMP encoder channel
video1.jpeg         = true      # JPEG at video1 resolution (e.g. 640x360)
video1.jpeg_chn     = 4

# ---- image rotation (videoN.rotation) -------------------------------------
# 0 | 90 | 180 | 270. 90 = clockwise on T23/T40/T41; on T31, 90 = counter-
# clockwise instead (kept numerically aligned with prudynt-t/raptor's raw
# rotation=1|2 config values - see docs/rotation.md "Notes on direction").
# NOTE: on T31, hardware OSD/privacy currently do NOT work on 90 or 270 when
# the stream is downscaled from the sensor - see docs/rotation.md "Known
# limitation". Restart-required (applied at build time of the pipeline). The
# advertised/recorded dimensions swap for 90/270 (a rotated 1920x1080 becomes
# 1080x1920). See docs/rotation.md for full detail.
#
# OFF BY DEFAULT - must be enabled at build time (menuconfig), like AAC/TLS:
#   BR2_PACKAGE_TIMPS_ROTATE      -> 180 on all SoCs + HW 90/270 on T31/T40/T41
#   BR2_PACKAGE_TIMPS_SW_ROTATE   -> software 90/270 on T23 (needs the above)
# Without these, 90/180/270 in this file are ignored (coerced to 0 with a warn).
#
# What each chip supports:
#   T40, T41 : 90/180/270 in HARDWARE (I2D) - full fps, OSD+privacy work, any res
#   T31      : 90/180/270 - 90/270 is libimp SOFTWARE rotate: <=1280x704 @ <=15fps,
#              64-px aligned, extra rmem, no soft-zoom
#   T23      : 180 in HW; 90/270 only with SW_ROTATE = CPU transpose + software
#              H.264 encode. H264 only, SW text-OSD only (no logo/privacy),
#              substream-class res (~<=704x576 @ <=15fps). Snapshot+MJPEG work,
#              but JPEG needs the rotated width (= source HEIGHT) %32==0: use
#              e.g. 1280x704 -> 704x1280, not 1280x720.
#   T10/T20/T21/T30/C100 : 180 only (no 90/270 primitive)
#
# Cost: 180 + HW 90/270 add ~none (binary +<1KB, no runtime cost). The T23 SW
# path adds ~7KB binary AND ~6MB of frame buffers + ~1 CPU core per rotated
# 720x1280 stream - hence the substream-class recommendation.

# ---- live vs restart (videoN.* via POST /control) --------------------------
# Every videoN.* key is stored and persisted immediately. Geometry/codec/fps
# keys take effect on the next daemon restart. The RATE-CONTROL subset is also
# applied to the RUNNING encoder (per channel, effective at the next IDR/GOP)
# where the SoC's SDK allows it:
#   T10..T30 (incl. T23): rc_mode, bitrate, qp, min_qp, max_qp, quality_lvl,
#                         change_pos, i_bias_lvl   (H264 streams only)
#   T31/C100:             bitrate, min_qp, max_qp, qp (fixqp), i_bias_lvl
#   T40:                  bitrate, min_qp, max_qp, qp (fixqp)
#   T41:                  bitrate, min_qp, max_qp
# GET /control advertises the set as caps.video_live; each POST reply lists
# what did NOT apply live under "deferred"/"deferred_keys" (e.g. the encoder
# channel is not running). The actual values the encoder holds are readable
# as encoder.<n>.rc in GET /control - compare after writing.

# ---- main video stream (channel 0) ----
video0.enabled   = 1
video0.codec     = h264      # h264 | h265
video0.width     = 1920
video0.height    = 1080
video0.fps       = 25
# bitrate means DIFFERENT things per SoC generation (deliberate, documented
# rather than papered over):
#   classic (T10..T30, T23): written into maxBitRate/outBitRate - under vbr/
#     smart it is a HARD CEILING the controller works below.
#   new API (T31/C100/T40/T41): passed as uTargetBitRate - a TARGET the
#     controller aims at, while the real cap uMaxBitRate stays at the SDK
#     default (readable since the encoder.<n>.rc readback, never written by
#     timps at bring-up; a live bitrate change preserves its ratio).
# So a T23-calibrated "ceiling" intuition does not transfer to a T31. Not
# unified via IMP_Encoder_SetChnBitRate at bring-up on purpose: that would
# change the fielded behaviour of every new-API camera based on header-only
# knowledge - measure with the rc readback first.
video0.bitrate   = 3000      # kbps
video0.rc_mode   = cbr       # cbr | vbr | fixqp | smart | capped_vbr | capped_quality
video0.gop       = 50
#video0.max_gop  = 60        # reserved, no effect - see comment above video_fields' max_gop entry
video0.profile   = 2         # 0 baseline 1 main 2 high
#video0.qp       = 35        # only used when video0.rc_mode = fixqp; no effect under cbr/vbr/etc (see video_fields' qp entry) - use min_qp/max_qp there instead
video0.min_qp    = 20
video0.max_qp    = 45

# Classic-SoC rate control (T10..T30). No effect on T31/C100/T40/T41, whose
# encoder API has no equivalent fields - timps warns once if you set them there.
#
#   quality_lvl  0..7   VBR/Smart only. The vendor SDK derives a HARD lower
#                       bound from it: minBitRate = bitrate * quality[lvl] with
#                       quality[] = {0.8,0.7,0.6,0.5,0.4,0.3,0.2,0.1}. The
#                       default 2 therefore refuses to go below 60% of
#                       video0.bitrate no matter how still the scene is; raise
#                       it to let quiet scenes get cheap. Lower = better
#                       picture, higher floor.
#   change_pos   50..100  VBR/Smart only. Percentage of bitrate above which the
#                       encoder starts raising qp. Default 80.
#   i_bias_lvl   -3..3  VBR and CBR. I-frame qp bias: negative spends more bits
#                       on keyframes, positive fewer. Default 0.
#   fluc_lvl     0..4   H265 only (ignored for h264 - the H264 rc structs have
#                       no such field). Allowed bitrate fluctuation relative to
#                       the average. Default 0 = the previous hardcoded value.
#
# Effect caveats, measured on a T23 (see the dev notes): the classic
# controller is QUALITY-seeking - it encodes the best quality min_qp allows
# and the bitrate follows. min_qp is therefore the operative lever (sweeping
# 20/30/38 under vbr gave 1743/1181/235 kbit/s); quality_lvl moves the
# operating point more gently (2->7: -27%); change_pos measurably did NOTHING
# (80/65/50 gave the same rate). Tune while watching encoder.<n>.rc in
# GET /control, and treat per-SoC behaviour as measured-on-T23, not
# guaranteed everywhere.
#
#video0.quality_lvl = 2
#video0.change_pos  = 80
#video0.i_bias_lvl  = 0
#video0.fluc_lvl    = 0
video0.rotation  = 0         # 0|90|180|270 - build-gated & SoC-dependent (see block above)
video0.buffers   = 2
video0.rtsp_path = /ch0
video0.imp_chn   = 0

# ---- sub video stream (channel 1) ----
video1.enabled   = 1
video1.codec     = h264
video1.width     = 640
video1.height    = 360
video1.fps       = 25
video1.bitrate   = 512
video1.rc_mode   = cbr
video1.gop       = 50
video1.profile   = 2
video1.rotation  = 0
video1.rtsp_path = /ch1
video1.imp_chn   = 1

# ---- audio ----
# Mic (AI) processing keys marked "live" apply immediately via /control; which
# ones a given SoC supports is reported in caps.audio (alc_gain only on
# T21/T31/C100). codec/samplerate/bitrate/channels are encoder-init attributes:
# they persist and take effect on restart. The SoC mic is mono; channels = 2
# (or force_stereo = 1) enables SIMULATED stereo: the mono capture is duplicated
# to L=R and encoded as 2-channel dual-mono AAC for clients that require a
# stereo track. AAC only - G.711 (pcmu/pcma) has no standard stereo and stays
# mono. On USE_PLAY / USE_BACKCHANNEL builds (the timps default) there IS an
# audio-OUT (AO) pipeline: audio.spk_enabled is the master gate for the physical
# speaker and audio.spk_volume/spk_gain are applied live (at the next AO open),
# see the speaker block below.
audio.enabled            = 1
audio.codec              = aac    # aac | pcmu | pcma | opus | none  (persist +
                                  #   restart; opus needs USE_STREAM_OPUS)
audio.samplerate         = 16000  # 8000-96000 Hz              (persist + restart)
audio.channels           = 1      # 1 mono | 2 = simulated stereo (dual-mono),
                                  # AAC only               (persist + restart)
audio.bitrate            = 32     # kbps, aac                 (persist + restart)
audio.volume             = 80     # live — IMP_AI_SetVol
audio.gain               = 25     # live — IMP_AI_SetGain
audio.alc_gain           = 0      # live — IMP_AI_SetAlcGain PGA 0..7 (T21/T31/C100)
audio.high_pass          = 0      # live — high-pass filter on/off
audio.agc                = 0      # live — automatic gain control on/off
audio.agc_target_dbfs    = 10     # live — AGC target level 0..31
audio.agc_compression_db = 0      # live — AGC compression gain 0..90
audio.ns                 = 0      # live — noise suppression 0 off, 1..3
audio.mute               = 0      # live — mic mute (1 = drop captured frames,
                                  #        clients receive no audio; no restart)
# aec: opt-in Acoustic Echo Cancellation (IMP_AI_EnableAec), default off. Only
# engages when BOTH the mic (AI) and the speaker (AO) are live; it subtracts the
# speaker output from the mic capture so the far end doesn't hear itself over the
# backchannel. Applied at the next AO open.
audio.aec                = 0      # live — 0 off, 1 on (USE_BACKCHANNEL/USE_PLAY)
# talk_ws: browser-microphone backchannel over a WebSocket at wss://<cam>:<http
# port>/talk (USE_BC_WS builds only). A browser cannot speak RTSP/RTP, so the
# ONVIF backchannel above is unreachable from a web page; this serves the same
# speaker path to one. Requires audio.backchannel=1 (it shares that pipeline and
# its single-talker arbitration) and http.https=1 — getUserMedia() is refused
# outside a secure context, so a plaintext listener could never be fed. Default
# off: this is a path from a visitor's microphone to the camera's speaker.
# Consider audio.aec=1 alongside it, or the far end hears itself.
audio.talk_ws            = 0      # restart — 0 off, 1 on (USE_BC_WS)
# speaker (AO) - active on USE_PLAY / USE_BACKCHANNEL builds:
#   spk_enabled = master gate for the physical speaker; when 0 neither the
#                 backchannel nor local playback produces any sound.
#   spk_volume / spk_gain = applied live to the AO if a play/backchannel session
#                 holds it, else at the next AO open; also persist as the default.
# audio.spk_enabled  = 1
# audio.spk_volume   = 80
# audio.spk_gain     = 25
# alias for audio.channels = 2: simulated stereo (dual-mono), AAC only,
# applies on restart
# audio.force_stereo = 0

# ---- ONVIF audio backchannel (client speaks -> camera speaker) -----------
# OPTIONAL, compile-time gated (USE_BACKCHANNEL; AAC needs USE_BC_AAC). The
# decoded audio is piped to thingino's audio daemon client /bin/iac, exactly
# like prudynt/raptor - timps never opens IMP_AO itself, so there is NO device
# conflict with portal/motion sounds. Requires the ingenic-audiodaemon package
# (/bin/iac) AND a camera that actually has a speaker wired.
#   codec  pcmu (default, 8 kHz, lowest latency, universal ONVIF support)
#          pcma (8 kHz A-law)
#          aac  (better quality, needs USE_BC_AAC + libhelix-aac, more latency)
# Half/one-talker: one RTSP client owns the speaker at a time. Restart-required.
# audio.backchannel        = 0      # master on/off
# audio.backchannel_codec  = pcmu   # pcmu | pcma | aac
# audio.backchannel_rate   = 16000  # speaker sample rate fed to iac (Hz)

# ---- OSD (up to 8 overlays PER video stream; own TrueType rasterizer) ----
osd.enabled        = 1
osd.monitor_stream = 0                        # stream feeding {fps}/{bitrate}
osd.font_path      = /usr/share/fonts/default.ttf   # default TTF; empty = bitmap font
osd.vars_file      = /tmp/timps_osd.vars                  # custom placeholder source
osd.supersample    = 2                        # TTF rasterizer AA: samples/axis/pixel
                                               # (1-4). 2 = default, visually identical
                                               # to 4 at typical OSD sizes but ~2x
                                               # cheaper to render; 4 = old default,
                                               # higher CPU; 1 = cheapest, visibly
                                               # rougher edges. No effect on the
                                               # embedded bitmap font (font_path empty).
# osd.hinting      = 0                        # Opt-in lightweight geometric autohint
                                               # (0/1). The TTF rasterizer does not
                                               # execute the font's embedded hint
                                               # bytecode, so small text (e.g. the
                                               # substream default 12px) can show
                                               # uneven stroke widths between glyphs.
                                               # Enabling this snaps stem-like outline
                                               # edges to the pixel grid to reduce
                                               # that unevenness - a coarse heuristic,
                                               # not real hinting. Default off: zero
                                               # change to existing OSD rendering
                                               # unless explicitly enabled. Restart-
                                               # required, like supersample above.
#
# Every video stream carries its OWN independent overlay set.
# Canonical keys:  osd<S>.<N>.<field>  = stream S (0 = main, 1 = sub), item N
#                  e.g. osd0.0.text (stream 0 item 0), osd1.2.x (stream 1 item 2)
# Legacy keys:     osd<N>.<field>  (pre-per-stream) still load and apply the
#                  item to EVERY stream, so old configs keep looking the same.
# Each item is either type=text or type=logo.
# Text placeholders:
#   time:    strftime tokens, e.g. %Y-%m-%d %H:%M:%S  %F %T
#   builtin: {hostname} {ip} {mac} {fps} {bitrate} {uptime}
#            {fpsN}/{bitrateN} (e.g. {fps1}, {bitrate1}) are stream N's own
#            figures; the no-number pair reads osd.monitor_stream for every
#            layer, whichever stream the layer belongs to
#   custom:  any {name} is read from osd.vars_file (key = value lines),
#            so a script can write e.g.  site = Frontdoor  into that file.
# Text outline (readability stroke, drawn under the fill):
#   outline       = width in px (0 = off, default)
#   outline_color = 0xAARRGGBB (default 0xFF000000 black)
# font_size is an ABSOLUTE pixel height and is NOT auto-scaled per stream, so
# set the sub-stream (osd1.*) size directly for legibility - a small sub-stream
# needs a proportionally similar px size, not a smaller number.
#
# Default layout (this matches config_defaults() in config.c exactly - shown
# explicitly here, like every other setting in this file, so the format is
# documented even though a fresh config already starts this way): date+time
# top-left, hostname centered, uptime top-right, logo bottom-right - 4 items,
# deliberately kept to that so the 1s-live clock item is the only one that
# re-renders every tick (hostname/uptime/logo are each their own item
# specifically so a static value never rides along with something that
# changes, and gets change-gated out after its first render - see
# refresh_text() in imp_osd.c). x/y follow the old-streamer convention
# (imp_osd.c resolve_pos): positive = from that edge, negative = from the
# opposite edge, 0 = centered on that axis.
osd0.0.enabled   = 1
osd0.0.type      = text
osd0.0.text      = %Y-%m-%d %H:%M:%S
osd0.0.x         = 10                         # from the left
osd0.0.y         = 10
osd0.0.font_size = 128
osd0.0.color     = 0xFFFFFFFF                 # ARGB
osd0.0.transparency = 255
osd0.0.outline       = 1                      # 1 px black stroke (on by default)
osd0.0.outline_color = 0xFF000000
# osd0.0.font_path =                          # optional per-item TTF override

osd0.1.enabled   = 1
osd0.1.type      = text
osd0.1.text      = {hostname}
osd0.1.x         = 0                          # 0 = centered horizontally
osd0.1.y         = 10
osd0.1.font_size = 32
osd0.1.color     = 0xFFFFFFFF
osd0.1.outline       = 1
osd0.1.outline_color = 0xFF000000

osd0.2.enabled   = 1
osd0.2.type      = text
osd0.2.text      = {uptime}
osd0.2.x         = -10                        # negative = from the right
osd0.2.y         = 10
osd0.2.font_size = 32
osd0.2.color     = 0xFFFFFFFF
osd0.2.outline       = 1
osd0.2.outline_color = 0xFF000000

osd0.3.enabled   = 1
osd0.3.type      = logo
osd0.3.logo      = /usr/share/images/thingino_100x30.bgra  # installed by the
                                               # thingino-logo package on every
                                               # thingino build - not timps-
                                               # specific, no per-camera asset
                                               # to provide. /usr/share/images/
                                               # thingino_210x64.bgra is the
                                               # larger variant if 100x30 reads
                                               # too small in the corner.
osd0.3.logo_w    = 100
osd0.3.logo_h    = 30
osd0.3.x         = -10                        # bottom-right
osd0.3.y         = -10
osd0.3.transparency = 200

# substream: same 4-item layout applies automatically (config_defaults()
# seeds it per-stream), just at a smaller absolute font_size - override
# item 0 here only as an example of picking a different sub-stream size;
# items 1-3 (hostname/uptime/logo) inherit the compiled default unless
# also given explicit osd1.N.* keys below.
osd1.0.enabled   = 1
osd1.0.type      = text
osd1.0.text      = %Y-%m-%d %H:%M:%S
osd1.0.x         = 10
osd1.0.y         = 10
osd1.0.font_size = 12                         # absolute px on the sub-stream
osd1.0.outline       = 1
osd1.0.outline_color = 0xFF000000

# ---- privacy masks (solid cover rectangles) ----
# Up to MS_MAX_PRIVACY (4) rectangles per video stream, drawn as IMP OSD cover
# regions to black out sensitive areas. Applied live via /control and here.
# Keys: privacy<S>.<N>.{enabled,x,y,w,h,color}. x/y/w/h in the stream's pixels;
# color is 0xAARRGGBB (default opaque black). caps.privacy in GET /control
# reports {available, max_regions}.
# privacy0.0.enabled = 1
# privacy0.0.x       = 100
# privacy0.0.y       = 80
# privacy0.0.w       = 320
# privacy0.0.h       = 180
# privacy0.0.color   = 0xFF000000

# ---- local recording (fragmented MP4 to SD, like raptor's RMR) ----
# Records one video stream to <dir>/<hostname>/records/<name>.mp4, rotating
# every segment_s at a keyframe. mode: continuous | motion (record around
# motion with pre/post roll; needs motion.enabled). Old segments are pruned to
# keep min_free_mb free. The /control "record" action (WebUI record button)
# is a manual start/stop override on top of this.
# record.enabled     = 1
# record.channel      = 0
# record.mode         = motion          # or: continuous
# record.dir          = /mnt/mmcblk0p1  # SD mount
# record.name         = %Y%m%d/%H/%Y%m%dT%H%M%S   # strftime, under <host>/records/
# record.segment_s    = 60
# record.pre_roll_s   = 3
# record.post_roll_s  = 10
# record.min_free_mb  = 200
# record.audio        = 1               # mux AAC audio when available

# ---- native timelapse (periodic JPEG snapshots) ----
# Every interval_s the newest JPEG frame is written to
# <dir>/<hostname>/timelapses/<name>.jpg (mkdir -p, atomic tmp+rename).
# channel picks the video stream whose piggyback JPEG encoder is captured
# (videoN.jpeg = true; falls back to the dedicated jpeg.* channel). dir may be
# ANY writable path (SD, NFS, ...). Shots older than keep_days are pruned
# (0 = keep forever). All keys are live via /control ("timelapse" section);
# the control-bar timelapse button toggles timelapse.enabled.
# timelapse.enabled    = 1
# timelapse.channel    = 0
# timelapse.dir        = /mnt/mmcblk0p1
# timelapse.name       = %Y%m%d/%H/%Y%m%dT%H%M%S   # strftime, .jpg appended
# timelapse.interval_s = 60
# timelapse.keep_days  = 7

# ---- motion detection (Ingenic IMP_IVS) ----
# The detection area is a cols x rows GRID over the monitor stream's frame;
# each cell reports motion separately (GET /control exposes the live per-cell
# state, the thingino WebUI draws it as a preview overlay). cols*rows is
# clamped to the SDK's ROI budget (IMP_IVS_MOVE_MAX_ROI_CNT: 52 on most SDKs,
# 4 on the old T10/T20 3.9.0 SDK; reported as caps.motion.max_cells).
# enabled/sensitivity/cols/rows/monitor_stream are live via /control;
# cooldown_ms and on_motion are config-file only (on_motion is exec'd
# directly, no shell, no arguments - deliberately not settable over HTTP).
motion.enabled        = 0
motion.monitor_stream = 0
motion.sensitivity    = 128           # 0..255 (mapped to IMP 0..4)
motion.cols           = 5             # grid columns
motion.rows           = 5             # grid rows
motion.cooldown_ms    = 5000
motion.hold_ms        = 800           # keep a cell lit this long (ms) after its
                                      # last hit so the grid overlay reliably
                                      # shows single-frame motion (0 = raw)
motion.skip_frames    = 5             # analyse every Nth frame: higher = cheaper
                                      # + more latency, lower (2-3) = snappier
# motion.on_motion    = /etc/scripts/on_motion.sh

# ---- automatic day/night (needs timps built with USE_DAYNIGHT) ----
# timps samples the ISP exposure state and switches via the board's daynight
# script (ircut / IR LEDs / color).
#
# The metric is the EXPOSURE INDEX: total_gain (IMP [24.8] linear, 256 = 1x)
# scaled by the AE's integration-time ratio. Higher = darker. In a dark scene
# the integration time is railed at max and the index IS total_gain, so the
# thresholds below mean exactly what they always did; in a bright scene the
# gain rails at its 256 floor and the index keeps falling, which is the range
# bare gain does not have.
#
# The two directions are NOT symmetric, because the two optical paths are not
# equally trustworthy. In day (IR-cut closed, illuminator off) the reading is
# an honest measure of ambient light, so day -> night is a plain measurement.
# In night the camera is partly measuring its own IR, so night -> day is only
# ever decided by a PROBE: switch to the day pipeline, let the AE settle, judge
# once. A probe costs an audible IR-cut click, and probe_min_gap_s is the one
# rule rationing it.
daynight.enabled        = 1                    # 0 = manual mode (WebUI/`/control` only)
# auto     = the automaton above; the calendar below is optional and only makes
#            the heartbeat smarter. Works fine with no location data at all.
# schedule = the calendar decides outright: no sensor, no probes.
daynight.mode           = auto                 # auto | schedule
# The calendar (optional in auto, required in schedule). An explicit time
# window wins; otherwise a non-zero lat/lon is used; otherwise there is none.
# daynight.time_night_start = 19:30            # local HH:MM
# daynight.time_day_start   = 06:30
# daynight.sun_latitude          = 0.0         # degrees, -90..90
# daynight.sun_longitude         = 0.0         # degrees, -180..180
# daynight.sun_sunrise_offset_min = 0          # minutes added to sunrise -> day
# daynight.sun_sunset_offset_min  = 0          # minutes added to sunset  -> night
# The two thresholds. Both are evaluated on the DAY pipeline only. 768 = 3x
# gain ("day is confirmed when the day pipeline can hold the scene at <= 3x"),
# 4096 = 16x ("colour is hopeless"). Old names total_gain_day_threshold /
# total_gain_night_threshold still work.
daynight.day_gain       = 768                  # index below this = day
daynight.night_gain     = 4096                 # index above this (in day) = night
daynight.day_confirm_s  = 30                   # how long before day -> night
# Probe economy. The trigger bar is relative to the night reference - the
# level at which night was last PROVEN - so "someone turned a light on" is
# one full stop of new brightening, held for probe_confirm_s. Colour comes
# back roughly probe_confirm_s + the fixed probe-settle time after the light
# goes on.
daynight.probe_min_gap_s = 600                 # never two probes closer than this
daynight.probe_confirm_s = 15                  # ... and stays there this long
# probe_jump_pct (50), probe_settle_s (8) and ref_delay_s (30) used to be
# settable here too. As of the 2026-08-22 config consolidation they are
# fixed internal constants (DN_PROBE_JUMP_PCT/DN_PROBE_SETTLE_S/
# DN_REF_DELAY_S in src/daynight.h) - every camera measured wanted the same
# values. Setting them here still parses but is ignored, with one warning if
# the value differs from the constant.

# The SILENT probe. Where the board can switch its IR illuminator on its own,
# the automaton asks the cheap question first: turn the illuminator off for a
# few seconds and compare. r = index(off) / index(on). A high r means the
# illuminator was carrying the scene (night); a low one means the room
# supplies the light (day). The ratio is dimensionless, so one pair of
# thresholds fits every camera - no absolute level does, genuine daylight
# spans a factor of 63 across a fleet at one instant.
#
# This costs no motor movement at all. The audible IR-cut probe below is the
# fallback: no irprobe_cmd, no usable reading, or a ratio between the two
# thresholds. Clearing irprobe_cmd disables the silent probe AND the trend
# path, leaving the jump trigger and the heartbeat.
daynight.irprobe_cmd     = timps-irprobe       # run as "<cmd> on|off"; empty = audible probe only
# ir_ratio_night (2.0), ir_ratio_day (2.0) and ir_min_headroom (8) used to be
# settable here too. As of the 2026-08-22 config consolidation they are
# fixed internal constants (DN_IR_RATIO_NIGHT/DN_IR_RATIO_DAY/
# DN_IR_MIN_HEADROOM in src/daynight.h), re-derived from a twelve-camera
# dusk-to-dawn campaign that found every camera wanted the same values.
#
# A low ratio says the illuminator is not earning its keep. It does NOT say
# day mode is usable, because switching also closes the IR-cut filter, and in
# a dim interior that filter alone can cost a factor of three. The automaton
# measures that factor the first time a ratio verdict is undone by night_gain,
# then requires the projected day reading to clear night_gain before it will
# act on a ratio again. Without it a dimly lit room flaps all night. The
# factor is measured per scene, not configured, and is re-measured after a
# restart.
# The heartbeat: a probe regardless of any reading. This is the ONLY bound on
# how long a wrong night can last, so it is a flat interval and never doubles.
# A scene that has not moved since the last probe waits heartbeat_max_s instead
# (nothing new to spend a click on) - a dark closet therefore costs two click
# pairs a day, and never any at all if it also never changes.
daynight.heartbeat_s     = 14400               # 4 h while the scene is moving
daynight.heartbeat_max_s = 43200               # 12 h once it demonstrably is not
daynight.boot_probe      = 1                   # 1 = one probe per boot when the persisted mode is night
# boot_settle_s (5) used to be settable here too; as of the 2026-08-22 config
# consolidation it is the fixed DN_BOOT_SETTLE_S constant (src/daynight.h).
#
# Learning (daynight.learn/daynight.state_path) was removed outright in the
# same consolidation: it recorded each confirmed day's brightest reading and
# could raise day_gain from the median of the last 8, but its own safety
# clamp (never past night_gain/2) could not raise it far enough for the
# cameras that actually needed it. daynight.diagnose_thresholds below is
# what is left - it names the value to raise by hand.
daynight.interval_ms    = 2000                 # sample interval
# transition_s (5) used to be settable here too; as of the 2026-08-22 config
# consolidation it is the fixed DN_TRANSITION_S constant (src/daynight.h).
daynight.switch_cmd     = daynight             # run as "<cmd> day|night"
daynight.isp_path       = /proc/jz/isp/isp-m0  # ISP exposure proc file
# Opt-in threshold diagnostic: warn once a day if no probe has ever confirmed
# day and the best day-pipeline reading is still clear of day_gain.
# daynight.diagnose_thresholds = 1
# Opt-in decision-trace recorder (incident diagnostics / replay harness): one
# CSV line per 5 samples of the index, its two inputs and the scheduling state.
# Size-capped (1 MB, rotated once to <path>.1). tmpfs ONLY - never point this
# at flash. File-only key, not settable via /control.
# daynight.trace_path   = /tmp/daynight-trace.csv

# ---- on-demand ----
# All streams (H264/H265, audio, JPEG/MJPEG) are only captured and encoded
# while at least one client is connected. No CPU is spent when nobody watches.
# This is automatic; there is nothing to configure.

# ---- simulation backend (host testing only, ignored on device) ----
# sim.video0 = /tmp/ch0.h264
# sim.video1 = /tmp/ch1.h264
# sim.audio  = /tmp/aud.aac
# sim.jpeg   = /tmp/snap.jpg
